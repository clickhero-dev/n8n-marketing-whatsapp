# Não usamos Postgres próprio — o n8n guarda o próprio estado em SQLite (volume n8ndata)
# e as tabelas da campanha vivem no bni-postgres existente (banco bni_connect).
# Configure a credencial "Postgres Campanha" direto na UI do n8n com:
#   host=bni-postgres  port=5432  database=bni_connect  user=bni  password=<a senha do bni-postgres>
N8N_ENCRYPTION_KEY=
WEBHOOK_URL=http://localhost:5678/

SENDGRID_API_KEY=
SENDGRID_FROM=jean@vendedormestre.com.br

WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=pt_BR
WA_VERIFY_TOKEN=
WA_APP_SECRET=

UNSUBSCRIBE_HMAC_SECRET=
